# ORCA Backend - environment variables
# Copy to backend/.env and fill in real values. backend/.env is gitignored.

# --- LLM Explainer (Google Gemini, free tier) ---
# Get a free key at https://aistudio.google.com  ->  "Get API key"
GEMINI_API_KEY=

# Optional overrides (defaults shown)
# ORCA_LLM_MODEL=gemini-flash-latest   # stable alias; or pin e.g. gemini-3.6-flash
# ORCA_LLM_ENABLED=auto            # auto | on | off  (auto = on iff GEMINI_API_KEY is set)
# ORCA_LLM_TIMEOUT_SECONDS=12.0
# ORCA_LLM_MAX_OUTPUT_TOKENS=800

# --- Server / data plane (defaults shown) ---
# HOST=0.0.0.0
# PORT=8000
# DEBUG=True
# ORCA_DATA_MODE=DEMO             # LIVE | FAILOVER | DEMO

# --- Map API Keys (Optional - Free Esri Dark Gray Canvas & Ocean Bathymetry used by default) ---
# MAPTILER_API_KEY=
# CARTO_API_KEY=
